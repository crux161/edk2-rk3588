## @file
#  NimbusPkg: the parts of the firmware that belong to NIMBUS/KUMO (PROPOSAL/024).
#
#  The splash is drawn by the same Rust renderer every later stage of the boot runs
#  (kumo-splash, linked as libkumo_splash_ffi.a), so the picture continues without a seam when
#  Nijigumo, MUREX and drv-fb take over the glass.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = NimbusPkg
  PACKAGE_GUID                   = 11EA1987-6C81-41B4-94F3-6E25535DD7EE
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  ## NIMBUS_SPLASH_STATE configuration table: the 80-byte record later stages read.
  gNimbusSplashStateGuid = { 0x4F6D983C, 0xC4BB, 0x4218, { 0x9D, 0x31, 0xBA, 0x44, 0x7B, 0x4B, 0xC8, 0x1F } }
  gNimbusPkgTokenSpaceGuid = { 0x11EA1987, 0x6C81, 0x41B4, { 0x94, 0xF3, 0x6E, 0x25, 0x53, 0x5D, 0xD7, 0xEE } }

[PcdsFixedAtBuild]
  ## Target interval between splash frames, in milliseconds. The driver stretches it so drawing
  #  never takes more than half the CPU.
  gNimbusPkgTokenSpaceGuid.PcdNimbusSplashFrameMs|66|UINT32|0x00000001
